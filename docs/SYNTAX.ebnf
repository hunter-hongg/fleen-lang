(* ============================================ *)
(* Fleen EBNF Grammar v0.0.3                    *)
(* New in 0.0.2: box/deref/move/clone prefix    *)
(* expressions, the ? suffix, Ok/Err patterns,  *)
(* deref assignment targets, the as cast layer, *)
(* and optional semicolons (ASI)                *)
(* New in 0.0.3: struct declarations &          *)
(* literals, array types & literals and         *)
(* a[i] indexing, field access, the for loop    *)
(* over arrays / Range, and the Range type      *)
(* plus the module system (`import` / `pub`,    *)
(* qualified module paths; V05). std land in    *)
(* later 0.0.3 tickets.                         *)
(* ============================================ *)

(* ---------- Program ---------- *)

program         = { import_decl | declaration } ;

import_decl     = "import" , module_path ;

module_path     = ident , { "." , ident } ;


(* ---------- Declarations ---------- *)

declaration     = const_decl
                | func_decl
                | struct_decl
                | var_binding
                | expr_stmt ;

(* 0.0.3 V02: user-defined aggregate declaration; a struct declaration takes
   no trailing semicolon (same rule as func) and is not recursive (typeck) *)
struct_decl     = "struct" , ident , "{" , [ field_decl , { "," , field_decl } ] , [ "," ] , "}" ;

field_decl      = ident , ":" , type ;


(* ---------- Variable Bindings ---------- *)

var_binding     = ident , [ type_annot ] , "=" , expr , [ ";" ] ;

const_decl      = "const" , ident , [ type_annot ] , "=" , expr , [ ";" ] ;

type_annot      = ":" , type ;


(* ---------- Functions ---------- *)

func_decl       = "func" , ident , "(" , [ param_list ] , ")"
                  , [ type_annot ]
                  , ( "=" , expr , [ ";" ]
                    | block ) ;

param_list      = param , { "," , param } ;

param           = ident , ":" , type ;


(* ---------- Types ---------- *)

type            = base_type
                | array_type
                | box_type
                | ref_type
                | result_type
                | func_type
                | named_type ;

base_type       = "int" | "float" | "bool" | "string" | "unit" ;

(* 0.0.3: a bare name as a type — a user struct (V02) or the builtin Range (V04).
   Which names are valid types is checked by typeck. *)
named_type      = ident ;

array_type      = "[" , type , "]" ;

box_type        = "box" , "<" , type , ">" ;

ref_type        = "ref" , type ;

result_type     = "Result" , "<" , type , "," , type , ">" ;

func_type       = "(" , [ type , { "," , type } ] , ")" , "->" , type ;


(* ---------- Statements / Expressions ---------- *)

expr_stmt       = expr , [ ";" ] ;
(* Note: 0.0.1 requires an explicit trailing semicolon on expression statements;
   from 0.0.2 on, ASI is in place and semicolons are optional *)
(* (the parser decides via a "may continue" whitelist; explicit semicolons are
   always legal) — see DESIGN.md §3.9 *)
(* Special rule: within a choose/when/otherwise construct, the when and
   otherwise clauses themselves carry no semicolon *)
(* Only a choose used as a whole expression statement takes a trailing semicolon *)

block           = "{" , { declaration | expr_stmt } , "}" ;


(* ---------- Expressions ---------- *)

expr            = if_expr
                | while_expr
                | for_expr
                | choose_expr
                | assign_expr ;

assign_expr     = logic_or , [ "=" , assign_expr ] ;
(* 0.0.2: the assignment target is extended to deref b (writes the value inside
   the box; no type annotation allowed)
   0.0.3 V02–V03: the target also includes `p.f` (field write, one level) and
   `a[i]` (index write) — the grammar only recognizes their shape; validity
   (a bare local/global receiver, direct field, bounds at runtime) is checked
   by the semantic phases *)

if_expr         = "if" , expr , block
                  , { "elif" , expr , block }
                  , [ "else" , block ] ;
(* Note: when if_expr is used as an expression statement, 0.0.1 requires a trailing semicolon *)

while_expr      = "while" , expr , block ;
(* Note: when while_expr is used as an expression statement, 0.0.1 requires a trailing semicolon *)

for_expr        = "for" , ident , "in" , expr , block ;
(* Note: `for` is new in 0.0.3 and is a statement like `while`; as an expression
   statement the trailing semicolon is optional from 0.0.2 (ASI), per the same rules *)
(* Note: `for` and `in` are reserved keywords from 0.0.3; the loop variable is a fresh
   immutable binding per iteration; the iterable must be an array [T] or a Range,
   and is evaluated once before the loop *)

choose_expr     = "choose" , expr , "{"
                  , { when_clause }
                  , [ otherwise_clause ]
                  , "}" ;
(* Note: when choose_expr is used as an expression statement, 0.0.1 requires a trailing semicolon *)
(* Note: the when and otherwise clauses themselves carry no semicolon;
   only the whole construct takes a trailing semicolon *)

when_clause     = "when" , pattern , [ "if" , expr ] , block ;
(* Note: a when clause carries no semicolon *)

otherwise_clause = "otherwise" , block ;
(* Note: an otherwise clause carries no semicolon *)

pattern         = neg_pattern
                | literal
                | ident
                | result_pattern ;

(* P5: choose pattern also accepts negated numeric literals *)
neg_pattern     = "-" , (int_lit | float_lit) ;

(* 0.0.2: the Ok/Err patterns for Result; bindings follow move semantics;
   Ok + Err arms together are exhaustive, no otherwise needed *)
result_pattern  = ( "Ok" | "Err" ) , "(" , ident , ")" ;


(* ---------- Operator Precedence (lowest to highest) ---------- *)

logic_or        = logic_and , { "or" , logic_and } ;

logic_and       = equality , { "and" , equality } ;

equality        = comparison , { ( "==" | "!=" ) , comparison } ;

comparison      = additive , { ( "<" | ">" | "<=" | ">=" ) , additive } ;

additive        = multiplicative , { ( "+" | "-" ) , multiplicative } ;

multiplicative  = cast , { ( "*" | "/" | "%" ) , cast } ;

(* 0.0.2 U13: the as cast layer, tighter than binary operators and looser than
   unary prefixes (same as Rust):
   deref b as string = (deref b) as string; 1 + 2 as string = 1 + (2 as string).
   The whitelist (int/float/bool → string) is checked by the semantic phases —
   the grammar only recognizes shape. *)
cast            = unary , { "as" , type } ;

(* 0.0.2: prefix keyword expressions, right-associative and stackable:
   clone deref b = clone(deref(b)); box box 1 = box(box(1)).
   Operand validity for move/clone/deref/box (place constraints, types) is
   checked by the semantic phases — the grammar only recognizes shape.
   `?` is a suffix that binds tighter than prefixes: deref b? = deref(b?)
   Special case for `box`: the operand parses at the cast layer,
   so box 1 as string = box (1 as string) *)
unary           = "box" , cast
                | unary_prefix , unary
                | postfix ;

unary_prefix    = "-" | "!" | "deref" | "move" | "clone" ;

postfix         = primary , { call_suffix | index_suffix | field_suffix | question_suffix } ;

(* 0.0.2: the ? propagation operator; its operand must be Result<T, E> — see DESIGN.md §8 *)
question_suffix = "?" ;

call_suffix     = "(" , [ arg_list ] , ")" ;

index_suffix    = "[" , expr , "]" ;

field_suffix    = "." , ident ;

arg_list        = expr , { "," , expr } ;


(* ---------- Primary Expressions ---------- *)

primary         = literal
                | ident
                | "(" , expr , ")"
                | block
                | array_literal
                | struct_literal ;

(* 0.0.3 V03: array literal; an empty literal needs a type annotation
   (CannotInferArrayType in typeck). Distinct from the index suffix `[ expr ]`
   by parse position (a primary `[` is a literal). *)
array_literal   = "[" , [ expr , { "," , expr } ] , [ "," ] , "]" ;

struct_literal  = ident , "{" , [ field_init , { "," , field_init } ] , [ "," ] , "}" ;

field_init      = ident , ":" , expr ;


(* ---------- Literals ---------- *)

literal         = int_lit
                | float_lit
                | bool_lit
                | string_lit ;

int_lit         = digit , { digit } ;

float_lit       = digit , { digit } , "." , digit , { digit } ;

bool_lit        = "true" | "false" ;

string_lit      = '"' , { any_char } , '"' ;


(* ---------- Identifiers ---------- *)

ident           = letter , { letter | digit | "_" } ;

letter          = "a" .. "z" | "A" .. "Z" | "_" ;

digit           = "0" .. "9" ;

any_char        = ? any character except a double quote ? ;


(* ---------- Comments ---------- *)

comment         = "//" , { any_char_except_newline } , newline
                | "/*" , { any_char } , "*/" ;

(* Note: 0.0.1 requires explicit semicolons; from 0.0.2 on, ASI (automatic
   semicolon insertion) is in place and semicolons are optional;
   explicit semicolons remain legal *)
