// 0.0.7 demo: parameterized enums end to end.
//
// Run: cargo fln examples/0.0.7/option_demo.fln
//
// Shows the four pieces 0.0.7 adds on top of 0.0.6 enums:
//   1. `enum Option<T>` — a type constructor (D1): every use site is fully
//      applied (`Option<int>`, never bare `Option`).
//   2. Argument-dependent Copy (D2): `Option<int>` is Copy (the payload is
//      Copy) and passes freely; `Option<string>` is owned and travels with
//      `move`.
//   3. Nested patterns (D5) and multi-payload destructuring (D4):
//      `Ok(Some(x))`, `Pair(a, b)`.
//   4. Or-patterns (D6) and type guards (D7): `Some(v) | Other(v)`,
//      `v: int`.
//
// The recursive-enum ban still holds (D3): `enum List<T> { Cons(T, List<T>) }`
// is a compile error.

enum Option<T> {
    Some(T),
    None,
}

enum Pipe<T> {
    Some(T),
    Other(T),
    Empty,
}

enum Pair<A, B> {
    P(A, B),
}

func unwrap_or(o: Option<int>, fallback: int): int {
    choose o {
        when Some(v) { v }
        when None { fallback }
    }
}

func main(): int {
    // 1+2. Constructing fixes the parameter from the payload; `Option<int>`
    // is Copy, so the same value may pass twice.
    a = Option.Some(5);
    print(unwrap_or(a, 0) as string);
    print(unwrap_or(a, 0) as string);

    // 2. The owned flow: `Option<string>` moves into the choose.
    s = Option.Some("hello");
    choose move s {
        when Some(t) { print(t); }
        when None { print("none"); }
    }

    // 3. Nested pattern inside the builtin Result.
    r: Result<Option<int>, string> = Ok(Option.Some(7));
    choose move r {
        when Ok(Some(x)) { print(x as string); }
        when Ok(None) { print("nothing"); }
        when Err(e) { print(e); }
    }

    // 3. Multi-payload destructuring one level down.
    p = Option.Some(Pair.P(3, "three"));
    choose move p {
        when Some(P(m, n)) {
            print(m as string);
            print(n);
        }
        when None { print("none"); }
    }

    // 4. Or-pattern spanning two variants: both alternatives bind `v` with
    // the same type.
    q1: Pipe<int> = Pipe.Other(20);
    choose q1 {
        when Some(v) | Other(v) { print(v as string); }
        when Empty { print("empty"); }
    }

    // 4. Type guard: `v: int` ascribes the binding (compile-time only).
    n = 5;
    choose n {
        when 0 { print("zero"); }
        when v: int { print(v as string); }
        otherwise { print("negative"); }
    }
    0
}
