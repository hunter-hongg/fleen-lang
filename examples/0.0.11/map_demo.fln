// 0.0.11 T08: map demo — literal, accessors, intrinsics, chaining.
//
// Ownership note (D2): `insert` / `remove` consume their input map and
// return a fresh one, so each binding is used exactly once after its
// producer runs; reusing an earlier binding needs `clone` (the PLAN D2
// canonical spelling for "keep the original alive").
import std.map;

func chained(nested: map[string, map[string, int]]): Result<int, string> {
    Ok(nested["row"]["x"]?)
}

func main() {
    // 1. Map literal + access + len
    m = map { 1 -> "one", 2 -> "two", 3 -> "three" };
    print("len:", std.map.len(m) as string);  // 3

    // 2. get (Result) — hit and miss
    r = m[2];
    choose move r {
        when Ok(v) { print("m[2] =", v); }
        when Err(e) { print("m[2] err:", e); }
    };
    r2 = m[99];
    choose move r2 {
        when Ok(v) { print("m[99] =", v); }
        when Err(e) { print("m[99] err:", e); }  // "key not found"
    };

    // 3. contains
    print("has 1:", std.map.contains(m, 1) as string);  // true
    print("has 4:", std.map.contains(m, 4) as string);  // false

    // 4. insert — the input is consumed (D2); a clone keeps `m` for §6
    m2 = std.map.insert(clone m, 4, "four");
    print("len after insert:", std.map.len(m2) as string);  // 4

    // 5. remove — consumes `m2` (D2)
    m3 = std.map.remove(m2, 1);
    print("len after remove:", std.map.len(m3) as string);  // 3
    print("has 1:", std.map.contains(m3, 1) as string);     // false

    // 6. chained access `m[k][k2]` (D4) + keys of the original map
    nested = map { "row" -> map { "x" -> 7, "y" -> 8 } };
    rc = chained(move nested);
    choose move rc {
        when Ok(cell) { print("chained:", cell as string); }  // 7
        when Err(e) { print("chained err:", e); }
    };
    ks = std.map.keys(m);
    print("keys:", ks[0] as string, ",", ks[1] as string, ",", ks[2] as string);  // 1, 2, 3
}
