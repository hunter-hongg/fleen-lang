// 0.0.2: Err path of an entry point returning Result.
// Run: cargo fln examples/0.0.2/err_exit.fln
// Expected: the payload is printed to stderr and the process exits with code 1
// (anything printed to stdout comes from code that ran before the Err).
func find_user(id: int): Result<string, string> {
    if id == 42 { Ok("answer") } else { Err("no such user") }
}

func main(): Result<int, string> {
    print("looking up 7...")
    name = find_user(7)?
    print("never reached")
    Ok(0)
}
