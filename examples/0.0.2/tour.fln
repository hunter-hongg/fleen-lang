// 0.0.2 "Hermit Crab" feature tour.
// Run: cargo fln examples/0.0.2/tour.fln
//
// Features covered:
//   1. ASI        -- semicolons optional (explicit semicolons still legal)
//   2. Ownership  -- explicit move transfers, clone deep-copies, Copy types unaffected
//   3. box<T>     -- heap allocation via box, deref reads/writes the boxed value
//   4. ref T      -- read-only borrowing (parameters only); locals and globals both work
//   5. Result     -- Ok/Err constructors, choose's Ok/Err patterns, ? propagation
//   6. as         -- scalar-to-string conversion (temporary 0.0.2 feature)
//   7. main returning Result -- Err bubbles up to the process: stderr + exit code 1

// ── ref T: read-only borrowed parameter. Reads owned values with zero copies;
//    the handle cannot escape. Borrowed parameters can only read;
//    clone the value if you need an owned copy ──
func describe(s: ref string, n: int) {
    print(s, " owns ", n as string, " box(es)")
}

// ── Result constructors: Ok / Err ──
func div(a: int, b: int): Result<int, string> {
    if b == 0 { Err("division by zero") } else { Ok(a / b) }
}

// ── ? propagation: on Err the whole function returns that Err immediately;
//    on Ok the payload is extracted ──
func half_of_diff(a: int, b: int, d: int): Result<int, string> {
    q = div(a - b, d)?
    Ok(q / 2)
}

// Global owned value: when passed as a ref argument it is copied through a
// temporary slot (no move/clone needed)
tagline = "hermit crab"

func main(): Result<int, string> {
    // ── 1. ASI: none of the lines below have a semicolon ──
    language = "fleen"
    milestone = "ownership begins"
    print(language, " 0.0.2 — ", milestone)

    // ── 2. Ownership ──
    owner = "vm"
    keeper = move owner        // transfer: owner can no longer be used (rejected at compile time)
    twin = clone keeper        // deep copy: both remain independently usable
    print("moved: ", keeper, " / cloned: ", twin)

    x = 41                     // int is a Copy type: assignment, argument passing,
    y = x                      // and returns all copy by value; no move/clone needed
    x = x + 1                  // x is still writable as usual (+ on int is unaffected)

    // ── 3. box<T>: heap allocation, deterministic deallocation (no GC) ──
    counter = box y            // counter: box<int>
    deref counter = deref counter + 1   // write the boxed value (y is unaffected)
    boxes = deref counter      // read the boxed value: yields a copy
    print("boxes on the heap: ", boxes as string, ", y still: ", y as string)

    // ── 4. ref T borrowing: both locals and globals can be borrowed ──
    describe(twin, boxes)
    describe(tagline, boxes)

    // ── 5. Result: choose's Ok/Err patterns. Both arms present means exhaustive;
    //    no otherwise needed (guarded arms do not count toward exhaustiveness) ──
    choose div(boxes, 2) {
        when Ok(v)  { print("exact half: ", v as string) }
        when Err(e) { print("refused: ", e) }
    }

    // ? propagates on the Err path: div(..., 0) produces an Err,
    // half_of_diff bubbles it up unchanged, and the choose here catches it
    outcome = choose half_of_diff(boxes, boxes, 0) {
        when Ok(v)  { v }
        when Err(e) { print("caught upstream: ", e)
                       0 - 1 }
    }
    print("outcome: ", outcome as string)

    // ── 7. Entry point returning Result: main ends with Ok, so the process exits 0 ──
    Ok(0)
}
