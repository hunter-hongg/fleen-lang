// expect-typeck: FutureNotStorable
// 0.0.4 review fix: `deref` deep-copies the pointee, so a box cell may not
// hold a `Result<Future, _>` — the box rule now sees through `Result`.
async func gen(x: int): int {
    x + 1
}

func main(): int {
    f = gen(1);
    r: Result<Future<int>, string> = Ok(move f);
    b = box move r;
    0
}
