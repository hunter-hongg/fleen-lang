// 0.0.2 U02: `Ok()` without a payload is not a valid Result pattern.
// 0.0.10 T02 (D1) stage shift (recorded): the parser no longer has an
// `Ok(`/`Err(` special case — this now parses as an ordinary zero-payload
// constructor pattern and is rejected here, at typeck (no matching enum
// scrutinee for the prelude constructor pattern).
r = 1;
choose r {
    when Ok() { 0 }
}
