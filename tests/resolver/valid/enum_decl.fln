// 0.0.6 T03: a top-level `enum` declaration is registered by the resolver
// (it joins the module export/import machinery like a struct) and collected
// into the HIR `enums` table as a type-table input for typeck (T04). It is
// not executable code, so it contributes no item; the program still runs.
enum Color {
    Red,
    Green,
}

func main() {
    print("ready");
}
