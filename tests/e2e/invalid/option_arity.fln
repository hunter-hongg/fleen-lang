// 0.0.7 T09 e2e: too many type arguments at a use site — the declared
// arity is checked at every application (D1).
enum Option<T> {
    Some(T),
    None,
}

func unwrap_or(o: Option<int, string>, fallback: int): int {
    choose o {
        when Some(v) { v }
        when None { fallback }
    }
}

func main(): int = 0
