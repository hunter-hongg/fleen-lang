// 0.0.4 T09 e2e: async code may read globals but not write them (T03, D5).
// A bare `p = ...` inside the body would be a local binding, so the write
// must go through the field form to reach the global.
struct Point {
    x: int,
}

p = Point { x: 0 };

async func bump() {
    p.x = 1;
}

func main() {}
