// 0.0.4 T07d: channels have no `==` — the derived comparison would compare
// *buffer contents*, so two distinct handles holding equal values would
// compare equal (silently aliasing what split-only forking keeps distinct).
import std.concurrent;
import std.io;

func main() {
    ch = channel<int>(0);
    peer = std.concurrent.split(ch);
    if ch == peer {
        std.io.println("same");
    }
}
