#feature curry
fib: int -> int
fib(n) {
    if n < 2 { n }
    elif n == 2 { 1 }
    else { fib(n - 1) + fib(n - 2) }
}
double: int -> int
double(n) = n * 2
greet: string -> string
greet(name) { name }
main: () -> unit
main() {
    print(fib(10) as string);
    print(double(21) as string);
    print("hi ", greet("curry"));
}
