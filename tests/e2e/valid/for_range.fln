// 0.0.3 V04 e2e: `for` over an array (V04) — accumulation, iteration order,
// empty iterable, owned elements, nested loops, and a body that assigns an
// outer mutable per the DESIGN.md §4.5 loop-scope rules.
//
// Range iteration is not source-constructible until V06
// (`std.collection.range`), so this file covers arrays only; the range
// opcodes (0xB9–0xBB) are covered by hand-built bytecode tests in
// fleen-vm/fleen-verify.
func main(): int {
    total = 0;
    for x in [10, 20, 30] {
        total = total + x;
    }
    print(total as string);

    for n in [1, 2, 3] {
        print(n as string);
    }

    empty_ran = 0;
    nothing_list: [int] = [];
    for nothing in nothing_list {
        empty_ran = 1;
    }
    print(empty_ran as string);

    for name in ["ann", "bob"] {
        print(name);
    }

    for i in [0, 1] {
        for j in [10, 20] {
            print((i * 10 + j) as string)}
    }

    last = 0;
    for v in [5, 6, 7] {
        last = v;
    }
    print(last as string);
    0
}
