// 0.0.3 V04 e2e: `for` over an array (V04) — accumulation, iteration order,
// empty iterable, owned elements, nested loops, and a body that assigns an
// outer mutable per the DESIGN.md §4.5 loop-scope rules.
//
// 0.0.3 V06 extends this file with Range iteration: `range`/`range_from`
// are recognized names lowering to `MakeRange` (D5), iterable without any
// import.
func main(): int {
    total = 0;
    for x in [10, 20, 30] {
        total = total + x;
    }
    print(total as string);

    for n in [1, 2, 3] {
        print(n as string);
    }

    empty_ran = 0;
    nothing_list: [int] = [];
    for nothing in nothing_list {
        empty_ran = 1;
    }
    print(empty_ran as string);

    for name in ["ann", "bob"] {
        print(name);
    }

    for i in [0, 1] {
        for j in [10, 20] {
            print((i * 10 + j) as string)}
    }

    last = 0;
    for v in [5, 6, 7] {
        last = v;
    }
    print(last as string);

    // V06: Range iteration. `range(n)` is `0..n`, `range_from(a, b)` is
    // `a..b` — both end-exclusive; an empty Range runs the body zero times.
    rtotal = 0;
    for i in range(5) {
        rtotal = rtotal + i;
    }
    print(rtotal as string);

    for i in range_from(2, 5) {
        print(i as string);
    }

    empty_range_ran = 0;
    for i in range_from(3, 3) {
        empty_range_ran = 1;
    }
    print(empty_range_ran as string);
    0
}
