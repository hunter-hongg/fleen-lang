// 0.0.9 T01 (BUG-2, PLAN D1): a zero-payload variant pattern is a variant
// reference, not a binding — the BUGS.md repro verbatim (the 0.0.7 pair_demo
// case 5 shape with the `otherwise` workaround removed).
//
// Run: cargo fln tests/e2e/valid/pair_zero_payload_variants.fln

enum Option<T> {
    Some(T),
    None,
}

enum Pair<A, B> {
    P(A, B),
}

func main(): int {
    p: Pair<Option<int>, Option<int>> = Pair.P(Option.None, Option.None);
    choose p {
        when P(None, None) { print("empty"); }   // was: DuplicateBinding on `None`
        when P(Some(z), Some(w)) { print("both"); }
        when P(Some(z2), None) { print(z2 as string); }
        when P(None, Some(w2)) { print(w2 as string); }
    }
    0
}
