// T08: std.map intrinsics end-to-end.
//
// Ownership note (D2): `insert` / `remove` consume their input map and
// return a fresh one, so each binding is used exactly once after its
// producer runs — the PLAN D2 canonical spelling. The "original map" is
// read BEFORE the consuming call, never after.
import std.map;

func main() {
    // len before any consuming call
    m = map { 1 -> 10, 2 -> 20 };
    print("orig_len=", std.map.len(m) as string);  // 2

    // insert (consumes m, D2)
    m2 = std.map.insert(m, 3, 30);
    print("len2=", std.map.len(m2) as string);  // 3

    // remove (consumes m2, D2)
    m3 = std.map.remove(m2, 1);
    print("len3=", std.map.len(m3) as string);  // 2
    print("has1=", std.map.contains(m3, 1) as string);  // false
    print("has2=", std.map.contains(m3, 2) as string);  // true

    // keys (insertion order, D8)
    ks = std.map.keys(m3);
    print("keys=", ks[0] as string, ",", ks[1] as string);  // 2,3

    // get (Result) — hit and miss
    r = m3[2];
    choose move r {
        when Ok(v) { print("get2=", v as string); }
        when Err(e) { print("err=", e); }
    };
    r2 = m3[99];
    choose move r2 {
        when Ok(v) { print("get99=", v as string); }
        when Err(e) { print("err99=", e); }  // "key not found"
    };
}
